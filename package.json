{
  "name": "showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm check:linked-builds && vite",
    "prebuild": "pnpm check:linked-builds && pnpm check:scope && pnpm check:react-web-api && pnpm check:slots-table && pnpm check:theme-template && pnpm check:theme-example && pnpm check:preview-props && pnpm check:report-shape && pnpm check:examples && pnpm check:skill-docs && pnpm check:library-cards",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
		"site:write": "pnpm build && rm -rf site && cp -R dist site",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "check:examples": "node scripts/sync-examples.mjs --check",
    "check:library-cards": "node scripts/check-library-cards.mjs",
    "examples:write": "node scripts/sync-examples.mjs",
    "check:skill-docs": "node scripts/check-skill-docs.mjs",
    "check:linked-builds": "node scripts/check-linked-builds.mjs",
    "scope:write": "node scripts/react-web-scope.mjs",
    "check:scope": "node scripts/react-web-scope.mjs --check",
    "check:react-web-api": "node scripts/check-react-web-api.mjs",
    "report-shape:write": "node scripts/proof-mode-report-shape.mjs",
    "check:report-shape": "node scripts/proof-mode-report-shape.mjs --check",
    "check:preview-props": "node scripts/check-preview-props.mjs",
    "slots:write": "node scripts/react-web-slots.mjs",
    "theme-template:write": "node scripts/uiux-theme-template.mjs",
    "check:theme-template": "node scripts/uiux-theme-template.mjs --check",
    "theme-example:write": "node scripts/uiux-theme-example.mjs",
    "check:theme-example": "node scripts/uiux-theme-example.mjs --check",
    "check:slots-table": "node scripts/react-web-slots.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "^1.161.4",
    "@turystack/react-charts": "file:../react-charts",
    "@turystack/react-hooks": "file:../react-hooks",
    "@turystack/react-i18n": "file:../react-i18n",
    "@turystack/react-icons": "file:../react-icons",
    "@turystack/react-web": "file:../react-web",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.22.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/router-plugin": "^1.161.4",
    "@turystack/entity": "file:../entity",
    "@turystack/exceptions": "file:../exceptions",
    "@turystack/fields": "file:../fields",
    "@turystack/query-dsl": "file:../query-dsl",
    "@turystack/saga": "file:../saga",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "zod": "^4.4.3"
  }
}
