{
	"name": "showcase",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "pnpm check:mobile-docs",
		"build": "tsc -b && vite build",
		"check:mobile-docs": "node --experimental-strip-types scripts/check-react-mobile-docs.mjs",
		"typecheck": "tsc -b",
		"preview": "vite preview",
		"lint": "biome lint ./src",
		"format": "biome format --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src"
	},
	"dependencies": {
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-router": "^1.161.4",
		"@turystack/react-hooks": "file:../react-hooks",
		"@turystack/react-icons": "file:../react-icons",
		"@turystack/react-web": "file:../react-web",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.575.0",
		"mermaid": "^11.16.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.22.0",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@tailwindcss/vite": "^4.1.11",
		"@tanstack/router-plugin": "^1.161.4",
		"@turystack/entity": "file:../entity",
		"@turystack/exceptions": "file:../exceptions",
		"@turystack/query-dsl": "file:../query-dsl",
		"@turystack/saga": "file:../saga",
		"@types/node": "^24.10.13",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@typescript/typescript6": "^6.0.2",
		"@vitejs/plugin-react-swc": "^4.2.3",
		"tailwindcss": "^4.1.11",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^7.0.2",
		"vite": "^7.3.1",
		"zod": "^4.4.3"
	}
}
